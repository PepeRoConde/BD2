  <transform>
    <name>User defined Java expression</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>SEASSON</field_name>
      <formula_string>(MONTH >= 3 &amp;&amp; MONTH &lt;= 5) ? "Spring" : (MONTH >= 6 &amp;&amp; MONTH &lt;= 8) ? "Summer" : (MONTH >= 9 &amp;&amp; MONTH &lt;= 11) ? "Autumn" : "Winter"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>HIGH_SEASSON</field_name>
      <formula_string>(MONTH >= 6 &amp;&amp; MONTH &lt;= 8) || MONTH == 12 ? 1 : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>1216</xloc>
      <yloc>224</yloc>
    </GUI>
